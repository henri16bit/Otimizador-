<Window x:Class="PCAnalyzer.App.Controls.AuditSettingDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Name}" Width="660" Height="640" MaxWidth="680"
 Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
 KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnPreviewKeyDown">
 <Window.Resources>
  <Style x:Key="DetailLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="DetailBody" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="LineHeight" Value="21"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22,18,22,16" Background="{StaticResource Background}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Description}" Style="{StaticResource DetailBody}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="ExplanationScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
   <StackPanel>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,16">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
       <TextBlock Text="Atual" Style="{StaticResource DetailLabel}"/>
       <TextBlock Text="{Binding CurrentValue}" Style="{StaticResource DetailBody}" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
       <TextBlock Text="Recomendado" Style="{StaticResource DetailLabel}"/>
       <TextBlock Text="{Binding RecommendedValue}" Style="{StaticResource DetailBody}" FontWeight="SemiBold"/>
      </StackPanel>
     </Grid>
    </Border>
    <TextBlock Text="Por que recomendo isso?" Style="{StaticResource DetailLabel}"/>
    <TextBlock Text="{Binding Reason}" Style="{StaticResource DetailBody}" Margin="0,0,0,14"/>
    <TextBlock Text="O que pode melhorar?" Style="{StaticResource DetailLabel}"/>
    <TextBlock Text="{Binding PossibleImpact}" Style="{StaticResource DetailBody}" Margin="0,0,0,14"/>
    <Grid Margin="0,0,0,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="Confiança da recomendação" Style="{StaticResource DetailLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" Style="{StaticResource DetailBody}"/>
    </Grid>
    <TextBlock Text="Como validar" Style="{StaticResource DetailLabel}"/>
    <TextBlock Text="{Binding Validation}" Style="{StaticResource DetailBody}" Margin="0,0,0,10"/>
    <Expander x:Name="TechnicalDetailsExpander" Header="Detalhes técnicos" IsExpanded="False" Margin="0,4,0,8" AutomationProperties.Name="Abrir evidências e fontes técnicas">
     <StackPanel Margin="0,10,0,0">
      <StackPanel x:Name="TechnicalRisksPanel" Margin="0,0,0,14">
       <TextBlock Text="Riscos e limites" Style="{StaticResource DetailLabel}"/>
       <TextBlock Text="{Binding Risks}" Style="{StaticResource DetailBody}"/>
      </StackPanel>
      <!-- Pages bound the number of text controls without adding a nested scrolling area. -->
      <ItemsControl x:Name="TechnicalEvidenceItems" AutomationProperties.Name="Evidências, valores completos e fontes">
       <ItemsControl.ItemTemplate><DataTemplate>
        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
         FontSize="13" Padding="0" Margin="0,0,0,12" MinHeight="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
         AutomationProperties.Name="Evidência técnica; texto disponível para copiar"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid x:Name="TechnicalEvidencePager" Margin="0,4,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TechnicalEvidencePageText" Style="{StaticResource DetailLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"
        AutomationProperties.LiveSetting="Polite"/>
       <Button x:Name="PreviousEvidenceButton" Grid.Column="1" Content="Anterior" Margin="0,0,8,0" Click="OnPreviousEvidence" AutomationProperties.Name="Página anterior de evidências"/>
       <Button x:Name="NextEvidenceButton" Grid.Column="2" Content="Próxima" Margin="0" Click="OnNextEvidence" AutomationProperties.Name="Próxima página de evidências"/>
      </Grid>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="RequestTestButton" Content="Testar comportamento" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,12,0" Click="OnRequestTest"
     ToolTip="Abre a confirmação de um teste diagnóstico. Nenhuma configuração será alterada."/>
    <Button x:Name="CloseDetailsButton" Grid.Column="1" Content="Fechar" IsCancel="True" Margin="0" MinWidth="86" Click="OnCloseDetails"/>
   </Grid>
  </Border>
 </Grid>
</Window>
