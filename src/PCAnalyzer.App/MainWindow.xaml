                                <Expander Header="Driver e identificação" IsExpanded="False"><StackPanel Margin="0,8,0,0"><CheckBox Content="Mostrar também conexões virtuais" IsChecked="{Binding ShowAllNetworkAdapters}"/><TextBlock Text="{Binding NetworkReadStatus}" Style="{StaticResource Note}"/><TextBlock Text="{Binding NetworkDriver}" Style="{StaticResource Note}"/><Button Content="Atualizar detalhes do adaptador" Command="{Binding InspectNetworkCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsLatencyCategory, Converter={StaticResource BooleanVisibility}}">
                                <TextBlock Text="Medições disponíveis" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding CategoryMeasurements}" Margin="0,0,0,12">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Width="240" Padding="14" Margin="0,0,10,10">
                                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Reading}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,4"/><TextBlock Text="{Binding State}" Style="{StaticResource Note}" FontSize="13" Margin="0"/></StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Cada teste mede uma parte do caminho. Não representa o input lag total." Style="{StaticResource Note}" FontSize="13"/>
                                <Expander Header="Executar teste de latência" IsExpanded="False">
                                    <StackPanel Margin="0,10,0,8">
                                        <TextBlock Text="Escolha a medição. Capturas e testes de carga pedem confirmação." Style="{StaticResource Note}"/>
                                        <WrapPanel><Button Content="DPC / ISR · 30 segundos…" Command="{Binding CaptureDpcCommand}"/><Button Content="Memória · acesso e cópia…" Command="{Binding MemoryAccessCommand}"/></WrapPanel>
                                        <TextBlock Text="Rede · destino do ping" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                        <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destino do teste de latência"/>
                                        <Button Content="Rede · 20 pings" Command="{Binding PingCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Frametime · processo aberto" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                        <ComboBox ItemsSource="{Binding VisibleProcesses}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Name" AutomationProperties.Name="Processo do teste de frametime"/>
                                        <Button Content="Frametime · 30 segundos…" Command="{Binding CaptureFramesCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding PresentMonStatus}" Style="{StaticResource Note}" FontSize="13" Margin="0,0,0,6"/>
                                        <Button Content="Configurar PresentMon…" Command="{Binding ConfigurePresentMonCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsNetworkCategory, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,12">
                                <TextBlock Text="Teste de rede" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Destino: gateway, IP ou nome DNS" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destino do teste de rede"/>
