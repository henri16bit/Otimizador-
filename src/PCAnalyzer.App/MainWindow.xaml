                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <Border Style="{StaticResource Card}" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExecutionPanel}"/></Border>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryTestResultTemplate}"/>
                            <StackPanel Visibility="{Binding IsAuditCategory, Converter={StaticResource BooleanVisibility}}">
                                <TextBlock Text="Configurações" Style="{StaticResource SectionTitle}" Margin="0,8,0,10"/>
                                <controls:AuditSettingsList/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="24,8,24,0" Padding="0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Notification}" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding Notification}"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Width="110" Height="5" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceHigh}" BorderThickness="0" Margin="0,0,12,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="0"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Margin="0" MinHeight="30" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
