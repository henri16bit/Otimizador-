<Window x:Class="PCAnalyzer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PCAnalyzer.App.Controls"
    Title="PC Performance Analyzer" Width="1280" Height="740" MinWidth="820" MinHeight="480"
    WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <DataTemplate x:Key="ExecutionPanel">
            <StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding ExecutionName}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/></DockPanel>
                <WrapPanel Margin="0,0,0,8"><TextBlock Text="{Binding ExecutionState}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Foreground="{StaticResource Muted}"><Run Text="Início: "/><Run Text="{Binding ExecutionStarted, Mode=OneWay}"/><Run Text=" · Decorrido: "/><Run Text="{Binding ExecutionElapsed, Mode=OneWay}"/></TextBlock></WrapPanel>
                <TextBlock Text="{Binding ExecutionStage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ExecutionDetail}" Style="{StaticResource Note}" Margin="0,4,0,6"/>
                <ProgressBar IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ExecutionPercent, Mode=OneWay}" Maximum="100" Height="5" Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceHigh}" BorderThickness="0" Margin="0,6,0,10" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}"/>
                <TextBlock Text="{Binding ExecutionOutcome}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PersistenceWarning}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Expander Header="Etapas recentes"><ItemsControl ItemsSource="{Binding ExecutionLog}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="IndicatorTemplate">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,10" MinWidth="150" MaxWidth="290">
                <StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Reading}" FontSize="23" FontWeight="SemiBold" Margin="0,6"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" Margin="0"/><Expander Header="Entender"><controls:MetricHelp Info="{Binding Info}" Margin="0,8,0,0"/></Expander></StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RecommendationTemplate">
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Note}" Margin="0,5,0,8"/>
                    <Button Content="{Binding ActionLabel}" Command="{Binding DataContext.SuggestedActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Action}" HorizontalAlignment="Left" Margin="0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ComponentAssessmentTemplate">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Inconclusivo"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Normal"><Setter Property="Text" Value="Sem sinal de problema"/><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Attention"><Setter Property="Text" Value="Atenção"/><Setter Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Problem"><Setter Property="Text" Value="Problema observado"/><Setter Property="Foreground" Value="{StaticResource Problem}"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,6"/>
                    <Expander Header="Ver evidências e limites">
                        <StackPanel Margin="8,8,0,0">
                            <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,8"><Run Text="Confiança: "/><Run Text="{Binding Confidence, Mode=OneWay, Converter={StaticResource DiagnosticLabel}}"/></TextBlock>
                            <ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Source}" Style="{StaticResource Note}" FontSize="13" Margin="0,3,0,0"/>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="13"><Run Text="{Binding Value, Mode=OneWay, StringFormat={}{0:0.###}}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:dd/MM HH:mm:ss}}"/></TextBlock>
                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding Limitations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Button Content="{Binding NextAction.Label}" Command="{Binding DataContext.SuggestedActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding NextAction}" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding NextAction}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AuditAssessmentTemplate">
            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ClassificationLabel}" FontWeight="SemiBold" Margin="0,5,0,6" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers>
                            <DataTrigger Binding="{Binding Assessment.Classification}" Value="DemonstratedProblem"><Setter Property="Foreground" Value="{StaticResource Problem}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Assessment.Classification}" Value="PossibleProblem"><Setter Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Assessment.Classification}" Value="Adequate"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                    <Expander Header="Por que importa · riscos · como validar">
                        <StackPanel Margin="6,8,6,0">
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Note}"/>
                            <TextBlock Text="Possível benefício" FontWeight="SemiBold"/><TextBlock Text="{Binding PossibleBenefit}" Style="{StaticResource Note}" Margin="0,4,0,12"/>
                            <TextBlock Text="Riscos da alteração" FontWeight="SemiBold"/><TextBlock Text="{Binding Risks}" Style="{StaticResource Note}" Margin="0,4,0,12"/>
                            <TextBlock Text="Como validar depois" FontWeight="SemiBold"/><TextBlock Text="{Binding Validation}" Style="{StaticResource Note}" Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding Confidence, Converter={StaticResource DiagnosticLabel}, StringFormat=Confiança: {0}}" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding SupportLabel}" Style="{StaticResource Note}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Evidências e fonte técnica">
                        <StackPanel Margin="6,8,6,0">
                            <TextBlock Text="Valor registrado" FontWeight="SemiBold"/><TextBlock Text="{Binding RawValue}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <TextBlock Text="{Binding Scope}" Style="{StaticResource Note}"/>
                            <ItemsControl ItemsSource="{Binding Facts}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="{Binding Limitation}" Style="{StaticResource Note}" Margin="0,6,0,10"/>
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Note}" FontSize="13"/>
                            <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" FontSize="13" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TechnicalConsultationReportTemplate">
            <StackPanel AutomationProperties.Name="Relatório na mesma tela">
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{Binding SimpleReportTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding SimpleReportState}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SimpleReportSummary}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding OpenedResultContext}" Style="{StaticResource Note}" FontSize="13"/>
                        <WrapPanel><Button Content="Exportar relatório…" Command="{Binding ExportTestCommand}"/><Button Content="Histórico" Command="{Binding NavigateCommand}" CommandParameter="historico" Style="{StaticResource QuietButton}"/></WrapPanel>
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding HasSimpleReport, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock Text="Por componente" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding ReportComponents}" ItemTemplate="{StaticResource ComponentAssessmentTemplate}"/>
                    <ItemsControl ItemsSource="{Binding ReportRecommendations}" ItemTemplate="{StaticResource RecommendationTemplate}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding HasAuditReport, Converter={StaticResource BooleanVisibility}}">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Cobertura da auditoria" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding AuditCoverage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="A cobertura informa o que foi lido. Não é uma nota de desempenho." Style="{StaticResource Note}"/>
                        <ItemsControl ItemsSource="{Binding AuditHighlights}" ItemTemplate="{StaticResource AuditAssessmentTemplate}"/>
                        <TextBlock Text="{Binding AuditAdequateSummary}" Style="{StaticResource Note}" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="Áreas verificadas" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding AuditCategories}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}" Margin="0,0,0,6"/>
                            <Expander Header="Ver configurações desta área"><ItemsControl ItemsSource="{Binding Assessments}" ItemTemplate="{StaticResource AuditAssessmentTemplate}" Margin="0,8,0,0"/></Expander>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Expander Header="Limites desta auditoria"><ItemsControl ItemsSource="{Binding AuditLimitations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,6,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PrioritySettingTemplate">
            <controls:AuditSettingRow/>
        </DataTemplate>
        <DataTemplate x:Key="CompactTestRecommendationTemplate">
            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Note}" Margin="0,4,0,6"/>
                    <Button Content="{Binding ActionLabel}" Command="{Binding DataContext.SuggestedActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Action}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CategoryIndicatorTemplate">
            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,10" MinWidth="150" MaxWidth="260">
                <StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reading}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CategoryLinksTemplate">
            <WrapPanel Margin="0,4,0,8">
                <Button Content="Windows" Command="{Binding NavigateCommand}" CommandParameter="windows"/>
                <Button Content="NVIDIA" Command="{Binding NavigateCommand}" CommandParameter="nvidia"/>
                <Button Content="Rede" Command="{Binding NavigateCommand}" CommandParameter="network"/>
                <Button Content="MSI / IRQ / USB" Command="{Binding NavigateCommand}" CommandParameter="devices"/>
                <Button Content="Latência" Command="{Binding NavigateCommand}" CommandParameter="latency"/>
                <Button Content="Hardware" Command="{Binding NavigateCommand}" CommandParameter="hardware"/>
                <Button Content="Jogos" Command="{Binding NavigateCommand}" CommandParameter="games"/>
            </WrapPanel>
        </DataTemplate>
        <DataTemplate x:Key="ConsultationReportTemplate">
            <StackPanel AutomationProperties.Name="Relatório na mesma tela">
                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="0,20,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding HomeAuditState}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding HomeAuditSummary}" Style="{StaticResource Note}"/>
                        <TextBlock Text="Melhorias possíveis" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding PriorityAuditSummary}" Style="{StaticResource Note}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="10,0,10,8" Visibility="{Binding HasPriorityAuditSettings, Converter={StaticResource BooleanVisibility}}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Configuração" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Grid.Column="1" Text="Atual" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Grid.Column="2" Text="Recomendação" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Grid.Column="3" Text="Status" Foreground="{StaticResource Muted}" FontSize="13"/>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding PriorityAuditSettings}" ItemTemplate="{StaticResource PrioritySettingTemplate}"/>
                        <Button Content="Ver recomendações" Command="{Binding NavigateCommand}" CommandParameter="ajustes" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,8"/>
                        <StackPanel Margin="0,12,0,8">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding RecommendedTests.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="Próximas medições" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding RecommendedTests}" ItemTemplate="{StaticResource CompactTestRecommendationTemplate}"/>
                        </StackPanel>
                        <Expander Header="Detalhes técnicos da análise" IsExpanded="False" Expanded="OnAuditDetailsExpanded">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TechnicalConsultationReportTemplate}" Margin="0,12,0,0"/>
                        </Expander>
                        <WrapPanel Margin="0,8,0,0"><Button Content="Exportar relatório…" Command="{Binding ExportAuditCommand}" Style="{StaticResource QuietButton}"/><Button Content="Histórico" Command="{Binding NavigateCommand}" CommandParameter="historico" Style="{StaticResource QuietButton}"/></WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CategoryTestResultTemplate">
            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,12,0,20" Visibility="{Binding HasCategoryTestResult, Converter={StaticResource BooleanVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding CategoryTestTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding CategoryResultState}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CategoryResultContext}" Style="{StaticResource Note}" FontSize="13"/>
                    <TextBlock Text="{Binding CategoryTestSummary}" Style="{StaticResource Note}"/>
                    <ItemsControl ItemsSource="{Binding CategoryTestIndicators}" ItemTemplate="{StaticResource CategoryIndicatorTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <Expander Header="Gráficos da medição" IsExpanded="False" Visibility="{Binding CategoryHasGraph, Converter={StaticResource BooleanVisibility}}">
                        <StackPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding CategoryResultSeries}" SelectedItem="{Binding SelectedCategorySeries}" DisplayMemberPath="Name"/><controls:RelativeTimeSeriesChart Series="{Binding SelectedCategorySeries}" Height="180"/></StackPanel>
                    </Expander>
                    <Expander Header="Limites e detalhes técnicos" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding CategoryTestDetails}" Style="{StaticResource Note}"/><ItemsControl ItemsSource="{Binding CategoryTestLimitations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Abrir resultado completo" Command="{Binding NavigateCommand}" CommandParameter="resultados" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/></StackPanel>
                    </Expander>
                    <Button Content="Exportar resultado…" Command="{Binding ExportTestCommand}" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#101012" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,20,10,14">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#29292F" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0"><TextBlock Text="PC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="PC Analyzer" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Somente leitura" FontSize="13" Foreground="{StaticResource Muted}"/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,18,6,0">
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,16"/>
                    <TextBlock Text="Dados no seu computador" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,5,0,0"><Run Text="Perfil "/><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IntervalSeconds, Mode=OneWay}"/><Run Text=" s"/></TextBlock>
                </StackPanel>
                <ListBox ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" x:Name="Navigation" ItemsSource="{Binding VisibleSections}" SelectedItem="{Binding MenuSelection}" AutomationProperties.Name="Navegação principal">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,24,24,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CollectionStateLabel}" HorizontalAlignment="Right" FontSize="13" Margin="0,0,8,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding CollectionStateLabel}" Value="Ao vivo"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger><DataTrigger Binding="{Binding IsHistoryView}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderIsAdvancedView, Converter={StaticResource BooleanVisibility}}">
                        <Button Content="{Binding PauseCaption}" Command="{Binding PauseCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" ToolTip="Pausa ou retoma somente a coleta passiva."/>
                        <Button Content="Salvar sessão" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0" ToolTip="Guarda as medições atuais no histórico local."/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="24,0,24,12" Background="#19191D" CornerRadius="8" Padding="12" Visibility="{Binding IsHistoryView, Converter={StaticResource BooleanVisibility}}">
                <DockPanel><Button DockPanel.Dock="Right" Content="Voltar ao vivo" Command="{Binding LiveCommand}" Margin="12,0,0,0"/>
                    <StackPanel><TextBlock Text="Você está vendo uma sessão salva." FontWeight="SemiBold"/><TextBlock Text="{Binding ViewContext}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                </DockPanel>
            </Border>
            <TabControl x:Name="MainPages" Grid.Row="2" Margin="24,0,24,0" Style="{StaticResource PageTabs}" SelectedIndex="{Binding ContentTab, Mode=OneWay}" AutomationProperties.Name="Página atual">
                <TabItem Header="Início">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,16">
                            <TextBlock Text="{Binding CompactHardwareSummary}" Style="{StaticResource Note}" Margin="0,0,0,24" AutomationProperties.Name="Resumo do computador"/>
                            <TextBlock Text="Verifique as configurações do Windows, drivers e interrupções." TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="ANALISAR MEU PC" Command="{Binding AnalyzePcCommand}" Style="{StaticResource PrimaryButton}" Padding="24,13" HorizontalAlignment="Left" AutomationProperties.Name="Analisar meu PC"/>
                            <TextBlock Text="Leitura e métricas passivas. Nenhuma configuração é alterada." Style="{StaticResource Note}" FontSize="13" Margin="0,4,0,20"/>
                            <Border Style="{StaticResource Card}" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExecutionPanel}"/></Border>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConsultationReportTemplate}" Visibility="{Binding HasHomeResult, Converter={StaticResource BooleanVisibility}}"/>
                            <TextBlock Text="Configurações por categoria" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CategoryLinksTemplate}"/>
                            <TextBlock Text="Abra uma categoria para consultar valores e escolher uma medição." Style="{StaticResource Note}" FontSize="13"/>
                            <Button Content="Reabrir última análise" Command="{Binding OpenLastDiagnosticCommand}" Visibility="{Binding HasDiagnostic, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Componentes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Componente" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding SelectedComponent}" DisplayMemberPath="Name" AutomationProperties.Name="Selecionar componente"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Buscar uma leitura" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding MetricFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar leituras" ToolTip="Procure pelo nome da leitura, identificador técnico ou origem."/></StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel><TextBlock Text="Leituras do componente" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Visibility="{Binding IsStorageComponent, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="Unidade física" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding DiskChoices}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="Name"/><TextBlock Text="Cada unidade mantém suas leituras. SMART e temperatura dependem do suporte da unidade e do método de leitura; confira a auditoria." Style="{StaticResource Note}"/></StackPanel><TextBlock Text="Selecione uma linha para ver seu gráfico. Leituras ausentes aparecem com —." Style="{StaticResource Note}" FontSize="13"/>
