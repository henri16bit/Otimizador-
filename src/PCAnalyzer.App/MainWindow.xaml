                                <TextBlock Text="20 pings para medir resposta, variação e perdas observadas. Não mede a latência dentro do jogo." Style="{StaticResource Note}" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsHardwareCategory, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding CompactHardwareSummary}" Style="{StaticResource Note}"/>
                                <Expander Header="Testes manuais de hardware" IsExpanded="False">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Geram carga e pedem confirmação. Escolha um teste por vez." Style="{StaticResource Note}"/>
                                        <WrapPanel><Button Content="CPU · uma tarefa…" Command="{Binding CpuSingleCommand}"/><Button Content="Memória · acesso e cópia…" Command="{Binding MemoryAccessCommand}"/><Button Content="Disco · ler um arquivo…" Command="{Binding DiskReadCommand}"/></WrapPanel>
                                        <TextBlock Text="Memória inclui efeitos do cache. Leitura de arquivo não equivale à velocidade física do NVMe." Style="{StaticResource Note}" FontSize="13"/>
                                    </StackPanel>
                                </Expander>
                                <Button Content="Abrir sensores e gráficos" Command="{Binding NavigateCommand}" CommandParameter="componentes" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsGamesCategory, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,12">
