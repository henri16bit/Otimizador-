<Window x:Class="PCAnalyzer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PCAnalyzer.App.Controls"
    Title="PC Performance Analyzer" Width="1280" Height="740" MinWidth="960" MinHeight="640"
    WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <DataTemplate x:Key="ExecutionPanel">
            <StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding ExecutionName}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/></DockPanel>
                <WrapPanel Margin="0,0,0,8"><TextBlock Text="{Binding ExecutionState}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Foreground="{StaticResource Muted}"><Run Text="Início: "/><Run Text="{Binding ExecutionStarted, Mode=OneWay}"/><Run Text=" · Decorrido: "/><Run Text="{Binding ExecutionElapsed, Mode=OneWay}"/></TextBlock></WrapPanel>
                <TextBlock Text="{Binding ExecutionStage}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ExecutionDetail}" Style="{StaticResource Note}" Margin="0,4,0,6"/>
                <ProgressBar IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ExecutionPercent, Mode=OneWay}" Maximum="100" Height="5" Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceHigh}" BorderThickness="0" Margin="0,6,0,10" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}"/>
                <TextBlock Text="{Binding ExecutionOutcome}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PersistenceWarning}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                <Expander Header="Etapas recentes"><ItemsControl ItemsSource="{Binding ExecutionLog}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="IndicatorTemplate">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,10" MinWidth="150" MaxWidth="290">
                <StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Reading}" FontSize="23" FontWeight="SemiBold" Margin="0,6"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" Margin="0"/><Expander Header="Entender"><controls:MetricHelp Info="{Binding Info}" Margin="0,8,0,0"/></Expander></StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RecommendationTemplate">
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Note}" Margin="0,5,0,8"/>
                    <Button Content="{Binding ActionLabel}" Command="{Binding DataContext.SuggestedActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Action}" HorizontalAlignment="Left" Margin="0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ComponentAssessmentTemplate">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Inconclusivo"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Normal"><Setter Property="Text" Value="Sem sinal de problema"/><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Attention"><Setter Property="Text" Value="Atenção"/><Setter Property="Foreground" Value="{StaticResource Attention}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Problem"><Setter Property="Text" Value="Problema observado"/><Setter Property="Foreground" Value="{StaticResource Problem}"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,6"/>
                    <Expander Header="Ver evidências e limites">
                        <StackPanel Margin="8,8,0,0">
                            <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,8"><Run Text="Confiança: "/><Run Text="{Binding Confidence, Mode=OneWay, Converter={StaticResource DiagnosticLabel}}"/></TextBlock>
                            <ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Source}" Style="{StaticResource Note}" FontSize="11" Margin="0,3,0,0"/>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="{Binding Value, Mode=OneWay, StringFormat={}{0:0.###}}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:dd/MM HH:mm:ss}}"/></TextBlock>
                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding Limitations}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Button Content="{Binding NextAction.Label}" Command="{Binding DataContext.SuggestedActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding NextAction}" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding NextAction}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#101827" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,24,14,18">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#346FE0" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0"><TextBlock Text="PC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="PC Analyzer" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Performance e diagnóstico" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,18,6,0">
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,16"/>
                    <TextBlock Text="Dados no seu computador" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Accent}" Margin="0,5,0,0"><Run Text="Perfil "/><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IntervalSeconds, Mode=OneWay}"/><Run Text=" s"/></TextBlock>
                </StackPanel>
                <ListBox x:Name="Navigation" ItemsSource="{Binding VisibleSections}" SelectedItem="{Binding MenuSelection}" AutomationProperties.Name="Navegação principal">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,24,24,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CollectionStateLabel}" HorizontalAlignment="Right" FontSize="11" Margin="0,0,8,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding CollectionStateLabel}" Value="Ao vivo"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger><DataTrigger Binding="{Binding IsHistoryView}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderIsAdvancedView, Converter={StaticResource BooleanVisibility}}">
                        <Button Content="{Binding PauseCaption}" Command="{Binding PauseCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" ToolTip="Pausa ou retoma somente a coleta passiva."/>
                        <Button Content="Salvar sessão" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0" ToolTip="Guarda as medições atuais no histórico local."/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="24,0,24,12" Background="#233654" CornerRadius="8" Padding="12" Visibility="{Binding IsHistoryView, Converter={StaticResource BooleanVisibility}}">
                <DockPanel><Button DockPanel.Dock="Right" Content="Voltar ao vivo" Command="{Binding LiveCommand}" Margin="12,0,0,0"/>
                    <StackPanel><TextBlock Text="Você está vendo uma sessão salva." FontWeight="SemiBold"/><TextBlock Text="{Binding ViewContext}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                </DockPanel>
            </Border>
            <TabControl x:Name="MainPages" Grid.Row="2" Margin="24,0,24,0" Style="{StaticResource PageTabs}" SelectedIndex="{Binding ContentTab, Mode=OneWay}" AutomationProperties.Name="Página atual">
                <TabItem Header="Visão geral">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,12">
                            <Border Style="{StaticResource Card}" Background="#192C48" BorderBrush="#365B8B" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Entenda o desempenho do seu PC" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Observe o computador, veja o que merece atenção e escolha o próximo passo." Style="{StaticResource Note}" Margin="0,5,0,14"/>
                                    <WrapPanel>
                                        <Button Content="ANALISAR MEU PC" Command="{Binding AnalyzePcCommand}" Style="{StaticResource PrimaryButton}" Padding="22,12" AutomationProperties.Name="Analisar meu PC"/>
                                        <Button Content="Analisar durante um jogo" Command="{Binding OpenGameAnalysisCommand}" Padding="18,12"/>
                                        <Button Content="Escolher duração e testes" Command="{Binding NavigateCommand}" CommandParameter="analisar" Style="{StaticResource QuietButton}" Padding="12,12"/>
                                    </WrapPanel>
                                    <TextBlock Text="A análise observa o sistema. Nenhuma configuração é alterada." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Padding="16" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExecutionPanel}"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Seu computador agora" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding CompactSystemRows}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid Margin="0,0,0,10" ToolTip="{Binding Detail}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="0,2,8,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Tentar ler novamente" Command="{Binding RetryTelemetryCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="10,5" MinHeight="30"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Última análise" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding LastDiagnosticState}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LastDiagnosticDate}" Style="{StaticResource Note}" FontSize="11" Margin="0,4,0,10"/>
                                        <TextBlock Text="{Binding LastDiagnosticSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding LastDiagnosticCounts}" Style="{StaticResource Note}" FontSize="12"/>
                                        <Button Content="Ver resultado e próximos passos" Command="{Binding OpenLastDiagnosticCommand}" IsEnabled="{Binding HasDiagnostic}" HorizontalAlignment="Left" Margin="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding PriorityRecommendations.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="Próximos passos" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding PriorityRecommendations}" ItemTemplate="{StaticResource RecommendationTemplate}"/>
                            </StackPanel>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Ver histórico" Command="{Binding NavigateCommand}" CommandParameter="historico" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><TextBlock Text="Análises recentes" Style="{StaticResource SectionTitle}"/></DockPanel>
                                    <TextBlock Text="As análises são salvas automaticamente neste computador." Style="{StaticResource Note}" FontSize="12" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding RecentAnalyses}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" Margin="0,0,12,0" AutomationProperties.Name="Análises recentes"/>
                                        <Button Grid.Column="1" Content="Abrir" Command="{Binding OpenTestCommand}" Margin="0"/>
                                    </Grid>
                                    <TextBlock Text="Sua primeira análise aparecerá aqui.">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="0,8,0,0"/><Style.Triggers><DataTrigger Binding="{Binding RecentAnalyses.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Componentes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Componente" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding SelectedComponent}" DisplayMemberPath="Name" AutomationProperties.Name="Selecionar componente"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Buscar uma leitura" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding MetricFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar leituras" ToolTip="Procure pelo nome da leitura, identificador técnico ou origem."/></StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel><TextBlock Text="Leituras do componente" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Visibility="{Binding IsStorageComponent, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="Unidade física" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding DiskChoices}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="Name"/><TextBlock Text="Cada unidade mantém suas leituras. SMART e temperatura não estão disponíveis nesta versão." Style="{StaticResource Note}"/></StackPanel><TextBlock Text="Selecione uma linha para ver seu gráfico. Leituras ausentes aparecem com —." Style="{StaticResource Note}" FontSize="11"/>
                                    <TextBlock Text="Aguardando leituras deste componente."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Metrics.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <DataGrid ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}" Height="260" AutomationProperties.Name="Leituras do componente">
                                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Leitura" Binding="{Binding Name}" Width="2*" MinWidth="165"/>
                                            <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="*" MinWidth="60"/>
                                            <DataGridTextColumn Header="Componente" Binding="{Binding Component}" Width="1.5*" MinWidth="90"/>
                                            <DataGridTextColumn Header="Disponibilidade" Binding="{Binding State}" Width="1.4*" MinWidth="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="{Binding SelectedMetric.Name, TargetNullValue=Selecione uma leitura para ver seu histórico, FallbackValue=Selecione uma leitura para ver seu histórico}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/><controls:TimeSeriesChart Samples="{Binding ChartSamples}" Height="180"/>
                                    <WrapPanel Margin="0,6"><TextBlock Text="Janela (minutos)" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox ItemsSource="{Binding ChartWindows}" SelectedItem="{Binding ChartWindowMinutes}" Width="90"/></WrapPanel>
                                    <TextBlock Text="{Binding ChartContext}" Style="{StaticResource Note}"/>
                                    <controls:MetricHelp Info="{Binding SelectedMetric.Info}" Margin="0,8,0,12"/>
                                    <Expander Header="Origem e detalhes da leitura"><StackPanel Margin="6,10,6,0"><TextBlock Text="{Binding SelectedMetric.Source}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedMetric.Details}" Style="{StaticResource Note}" Margin="0,8,0,0"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="Intervalo: "/><Run Text="{Binding SelectedMetric.Cadence, Mode=OneWay}"/><Run Text=" · horário: "/><Run Text="{Binding SelectedMetric.Time, Mode=OneWay}"/></TextBlock></StackPanel></Expander>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}"><Expander Header="Informações do hardware e do driver"><StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Informações reportadas pelo Windows e pelos provedores disponíveis." Style="{StaticResource Note}"/>
                                <DataGrid ItemsSource="{Binding Hardware}" Height="240"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Limitation}"/></Style></DataGrid.RowStyle>
                                    <DataGrid.Columns><DataGridTextColumn Header="Componente" Binding="{Binding Component}" Width="1.4*"/><DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="1.5*"/><DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </StackPanel></Expander></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Processos">
                    <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Buscar por nome ou PID" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar processos"/><TextBlock Text="Clique no cabeçalho de CPU ou memória para ordenar. A lista mostra os processos da coleta ao vivo." Style="{StaticResource Note}"/></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4"><Grid>
                            <DataGrid ItemsSource="{Binding VisibleProcesses}" SelectedItem="{Binding SelectedProcess}" AutomationProperties.Name="Processos em execução"><DataGrid.Columns>
                                <DataGridTextColumn Header="Aplicativo" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" SortMemberPath="Sample.CpuPercent" Width="*"/>
                                <DataGridTextColumn Header="Memória residente" Binding="{Binding Memory}" SortMemberPath="Sample.WorkingSetBytes" Width="*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                            </DataGrid.Columns></DataGrid>
                            <TextBlock Text="{Binding ProcessEmptyMessage}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VisibleProcesses.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid></Border>
                        <WrapPanel Grid.Row="2"><Button Content="Investigar FPS do processo selecionado" Command="{Binding OpenInvestigationCommand}" CommandParameter="jogos"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedProcess}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding SelectedProcess.Name}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,8"/></WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Investigar">
                    <TabControl x:Name="InvestigationPages" SelectedIndex="{Binding InvestigationTab}" BorderThickness="0">
                        <TabItem Header="Rede">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Recarregar" Command="{Binding DiscoverNetworkCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><TextBlock Text="Conexão detectada" Style="{StaticResource SectionTitle}"/></DockPanel>
                                    <TextBlock Text="A conexão é carregada ao abrir esta tela. Escolha outro adaptador se precisar." Style="{StaticResource Note}"/>
                                    <ComboBox ItemsSource="{Binding NetworkAdapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" AutomationProperties.Name="Adaptador de rede"/>
                                    <TextBlock Text="{Binding NetworkSelectionNote}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                                    <Button Content="Atualizar detalhes do adaptador" Command="{Binding InspectNetworkCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding NetworkReadStatus}" Style="{StaticResource Note}"/>
                                    <TextBlock Text="{Binding NetworkDriver}" TextWrapping="Wrap"/>
                                    <Expander Header="RSS, energia e contadores"><StackPanel Margin="0,10">
                                        <TextBlock Text="RSS distribui a recepção entre CPUs. Contadores acumulados não são perda no jogo. Energia pode depender do driver." Style="{StaticResource Note}"/>
                                        <DataGrid ItemsSource="{Binding NetworkFacts}" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="*"/></DataGrid.Columns></DataGrid>
                                    </StackPanel></Expander>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Teste a resposta da conexão" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Envia 20 pings. Mede resposta, variação e ausência de resposta." Style="{StaticResource Note}"/>
                                    <TextBlock Text="Destino: gateway ou IP/nome DNS" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destino do ping"/>
                                    <TextBlock Text="Gateway usa o adaptador escolhido. Um IP/nome usa a rota do Windows. Não informe URL ou porta." Style="{StaticResource Note}"/>
                                    <Button Content="Iniciar 20 pings" Command="{Binding PingCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Não mede latência do VALORANT. ICMP bloqueado não comprova perda no jogo." Style="{StaticResource Note}"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExecutionPanel}" Visibility="{Binding HasExecution, Converter={StaticResource BooleanVisibility}}"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Entenda antes de ajustar" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Leia a função antes de mudar. Valores só são alterados após revisão e confirmação." Style="{StaticResource Note}"/>
                                    <ComboBox ItemsSource="{Binding NetworkSettings}" SelectedItem="{Binding SelectedNetworkSetting}" DisplayMemberPath="Name"/>
