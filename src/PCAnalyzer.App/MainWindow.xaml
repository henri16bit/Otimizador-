<Window x:Class="PCAnalyzer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PCAnalyzer.App.Controls"
    Title="PC Performance Analyzer" Width="1320" Height="860" MinWidth="960" MinHeight="640"
    WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid Background="{StaticResource Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#101827" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,24,14,18">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#346FE0" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0"><TextBlock Text="PC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="PC Analyzer" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Performance e diagnóstico" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,18,6,0">
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,16"/>
                    <TextBlock Text="Dados no seu computador" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Accent}" Margin="0,5,0,0"><Run Text="Perfil "/><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding IntervalSeconds, Mode=OneWay}"/><Run Text=" s"/></TextBlock>
                </StackPanel>
                <ListBox x:Name="Navigation" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" AutomationProperties.Name="Navegação principal">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,24,24,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CollectionStateLabel}" HorizontalAlignment="Right" FontSize="11" Margin="0,0,8,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding CollectionStateLabel}" Value="Ao vivo"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger><DataTrigger Binding="{Binding IsHistoryView}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding PauseCaption}" Command="{Binding PauseCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" ToolTip="Pausa ou retoma somente a coleta passiva."/>
                        <Button Content="Salvar sessão" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0" ToolTip="Guarda as medições atuais no histórico local."/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="24,0,24,12" Background="#233654" CornerRadius="8" Padding="12" Visibility="{Binding IsHistoryView, Converter={StaticResource BooleanVisibility}}">
                <DockPanel><Button DockPanel.Dock="Right" Content="Voltar ao vivo" Command="{Binding LiveCommand}" Margin="12,0,0,0"/>
                    <StackPanel><TextBlock Text="Você está vendo uma sessão salva." FontWeight="SemiBold"/><TextBlock Text="{Binding ViewContext}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                </DockPanel>
            </Border>
            <TabControl x:Name="MainPages" Grid.Row="2" Margin="24,0,24,0" Style="{StaticResource PageTabs}" SelectedIndex="{Binding ContentTab, Mode=OneWay}" AutomationProperties.Name="Página atual">
                <TabItem Header="Visão geral">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,12">
                            <TextBlock Text="{Binding MachineSummary}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MachineSummary}" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding OverviewCards}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,16" Padding="16">
                                        <StackPanel>
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Accent}" Margin="5,0,0,0"/><TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DockPanel>
                                            <Grid Margin="0,12,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Value}" FontSize="29" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Unit}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceHigh}" BorderThickness="0" Margin="0,0,0,10">
                                                <ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding HasPercentage}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                            <Button Command="{Binding DataContext.OpenComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Background="Transparent" BorderThickness="0" Padding="0,5" MinHeight="26" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="Ver componente →" Foreground="{StaticResource Accent}"/></Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="O que você quer investigar?" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Escolha a situação que você está observando. Os testes só começam quando você os iniciar." Style="{StaticResource Note}"/>
                                    <WrapPanel>
                                        <Button Content="Quedas de FPS em jogos" Command="{Binding OpenInvestigationCommand}" CommandParameter="jogos"/>
                                        <Button Content="Conexão instável" Command="{Binding OpenInvestigationCommand}" CommandParameter="rede"/>
                                        <Button Content="Travadas e drivers" Command="{Binding OpenInvestigationCommand}" CommandParameter="drivers"/>
                                        <Button Content="Ver testes rápidos" Command="{Binding OpenInvestigationCommand}" CommandParameter="testes"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Ver detalhes" Command="{Binding OpenComponentCommand}" CommandParameter="cpu" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Uso da CPU ao longo do tempo" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/><TextBlock Text="Passe o mouse sobre o gráfico para consultar uma leitura." Style="{StaticResource Note}" FontSize="11"/></StackPanel></DockPanel>
                                    <controls:TimeSeriesChart Samples="{Binding OverviewChartSamples}" Height="170"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><Button DockPanel.Dock="Right" Content="Ver observações" Command="{Binding NavigateCommand}" CommandParameter="observacoes" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><TextBlock Text="{Binding FindingsSummary}" Style="{StaticResource SectionTitle}"/></DockPanel>
                                    <TextBlock Text="A triagem usa as leituras disponíveis. Uma observação isolada não confirma um defeito." Style="{StaticResource Note}"/>
                                    <ItemsControl ItemsSource="{Binding OverviewFindings}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6,0,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Explanation}" Style="{StaticResource Note}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Componentes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Componente" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding SelectedComponent}" DisplayMemberPath="Name" AutomationProperties.Name="Selecionar componente"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Buscar uma leitura" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding MetricFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar leituras" ToolTip="Procure pelo nome da leitura, identificador técnico ou origem."/></StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel><TextBlock Text="Leituras do componente" Style="{StaticResource SectionTitle}"/><TextBlock Text="Selecione uma linha para ver seu gráfico. Leituras ausentes aparecem com —." Style="{StaticResource Note}" FontSize="11"/>
                                    <TextBlock Text="Aguardando leituras deste componente."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Metrics.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <DataGrid ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}" Height="260" AutomationProperties.Name="Leituras do componente">
                                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Leitura" Binding="{Binding Name}" Width="2*" MinWidth="165"/>
                                            <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="*" MinWidth="70"/>
                                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unit}" Width="*" MinWidth="60"/>
                                            <DataGridTextColumn Header="Componente" Binding="{Binding Component}" Width="1.5*" MinWidth="90"/>
                                            <DataGridTextColumn Header="Disponibilidade" Binding="{Binding State}" Width="1.4*" MinWidth="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="{Binding SelectedMetric.Name, TargetNullValue=Selecione uma leitura para ver seu histórico, FallbackValue=Selecione uma leitura para ver seu histórico}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/><controls:TimeSeriesChart Samples="{Binding ChartSamples}" Height="180"/>
                                    <Expander Header="Origem e detalhes da leitura"><StackPanel Margin="6,10,6,0"><TextBlock Text="{Binding SelectedMetric.Source}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedMetric.Details}" Style="{StaticResource Note}" Margin="0,8,0,0"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="Intervalo: "/><Run Text="{Binding SelectedMetric.Cadence, Mode=OneWay}"/><Run Text=" · horário: "/><Run Text="{Binding SelectedMetric.Time, Mode=OneWay}"/></TextBlock></StackPanel></Expander>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}"><Expander Header="Informações do hardware e do driver"><StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Informações reportadas pelo Windows e pelos provedores disponíveis." Style="{StaticResource Note}"/>
                                <DataGrid ItemsSource="{Binding Hardware}" Height="240"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Limitation}"/></Style></DataGrid.RowStyle>
                                    <DataGrid.Columns><DataGridTextColumn Header="Componente" Binding="{Binding Component}" Width="1.4*"/><DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="1.5*"/><DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </StackPanel></Expander></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Processos">
                    <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Buscar por nome ou PID" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar processos"/><TextBlock Text="Clique no cabeçalho de CPU ou memória para ordenar. A lista mostra os processos da coleta ao vivo." Style="{StaticResource Note}"/></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4"><Grid>
                            <DataGrid ItemsSource="{Binding VisibleProcesses}" SelectedItem="{Binding SelectedProcess}" AutomationProperties.Name="Processos em execução"><DataGrid.Columns>
                                <DataGridTextColumn Header="Aplicativo" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" SortMemberPath="Sample.CpuPercent" Width="*"/>
                                <DataGridTextColumn Header="Memória residente" Binding="{Binding Memory}" SortMemberPath="Sample.WorkingSetBytes" Width="*"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/>
                            </DataGrid.Columns></DataGrid>
                            <TextBlock Text="A lista será exibida após a primeira coleta ao vivo." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Processes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid></Border>
                        <WrapPanel Grid.Row="2"><Button Content="Investigar FPS do processo selecionado" Command="{Binding OpenInvestigationCommand}" CommandParameter="jogos"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedProcess}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding SelectedProcess.Name}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,8"/></WrapPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Investigar">
                    <TabControl x:Name="InvestigationPages" SelectedIndex="{Binding InvestigationTab}" BorderThickness="0">
                        <TabItem Header="Rede">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Sua conexão está oscilando?" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Meça o tempo de resposta e a perda de pacotes para um destino. O teste envia 20 pings e mostra o resultado ao terminar." Style="{StaticResource Note}"/>
                                    <TextBlock Text="Destino (IP, hostname ou gateway)" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destino do teste de ping"/>
                                    <Button Content="Iniciar teste de conexão" Command="{Binding PingCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                    <Expander Header="Como interpretar"><TextBlock Text="Use gateway para testar o roteador local. RTT mede resposta ICMP; um destino que bloqueia ping pode aparentar perda mesmo com uma conexão funcionando. Esse teste não mede input lag físico." Style="{StaticResource Note}" Margin="6,10,6,0"/></Expander>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Confira também o adaptador" Style="{StaticResource SectionTitle}"/><TextBlock Text="Veja recebimento, envio e velocidade do link em Componentes. Propriedades de driver e energia ficam em Ajustes." Style="{StaticResource Note}"/><WrapPanel><Button Content="Ver leituras de rede" Command="{Binding OpenComponentCommand}" CommandParameter="rede"/><Button Content="Abrir ajustes" Command="{Binding NavigateCommand}" CommandParameter="ajustes" Style="{StaticResource QuietButton}"/></WrapPanel></StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Jogos">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Analise quedas de FPS e irregularidade de frames" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Se você já tem um CSV do PresentMon, importe-o para ver FPS, frametimes e percentis." Style="{StaticResource Note}"/>
                                    <Button Content="Importar captura CSV…" Command="{Binding ImportFramesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Fazer uma nova captura" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Selecione um processo. Ao iniciar, escolha o executável oficial do PresentMon e confirme a captura de 30 segundos." Style="{StaticResource Note}"/>
                                    <TextBlock Text="Processo em execução" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" AutomationProperties.Name="Processo para captura de frames"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · PID "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                    <WrapPanel><Button Content="Capturar frames por 30 s…" Command="{Binding CaptureFramesCommand}"/><Button Content="Ver processos" Command="{Binding NavigateCommand}" CommandParameter="processos" Style="{StaticResource QuietButton}"/></WrapPanel>
                                    <Expander Header="Informar PID manualmente"><StackPanel Margin="6,10,6,0"><TextBlock Text="PID do processo que deseja analisar" Style="{StaticResource Note}"/><TextBox Text="{Binding ProcessIdText, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="PID manual para captura de frames"/></StackPanel></Expander>
                                    <Expander Header="Ferramenta e permissões"><TextBlock Text="O PresentMon é uma ferramenta externa opcional. A captura não injeta código nem cria overlay. A compatibilidade com o jogo e com anticheat depende do ambiente; não há garantia de compatibilidade com Vanguard. A importação CSV funciona sem executar o PresentMon." Style="{StaticResource Note}" Margin="6,10,6,0"/></Expander>
                                </StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Travadas e drivers">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Investigue atividade de drivers durante uma travada" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="A captura de DPC/ISR registra eventos do Windows por 30 segundos. Reproduza o problema durante a captura e consulte o resumo ao terminar." Style="{StaticResource Note}"/>
                                    <TextBlock Text="O Windows solicitará autorização de administrador." Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <WrapPanel><Button Content="Capturar por 30 s…" Command="{Binding CaptureDpcCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Importar arquivo ETL…" Command="{Binding ImportEtlCommand}"/></WrapPanel>
                                    <Expander Header="O que esse teste mede"><TextBlock Text="DPC e ISR medem execução de rotinas do kernel. A captura pode identificar picos e módulos quando a resolução está disponível, mas não mede clique-para-fóton nem prova que um driver causou o problema. A captura é manual e acrescenta algum custo de processamento." Style="{StaticResource Note}" Margin="6,10,6,0"/></Expander>
                                </StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Testes rápidos">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <TextBlock Text="Cada teste apresenta seus limites e pede confirmação antes de começar." Style="{StaticResource Note}"/>
                                <Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="Testar CPU…" Command="{Binding CpuSingleCommand}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="CPU · uma thread" Style="{StaticResource SectionTitle}"/><TextBlock Text="Observe uma carga curta e controlada. O teste pode aumentar consumo e temperatura." Style="{StaticResource Note}" Margin="0"/></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="Testar memória…" Command="{Binding MemoryCommand}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="Memória · buffer de 32 MiB" Style="{StaticResource SectionTitle}"/><TextBlock Text="Exercita um buffer limitado. Não substitui um teste de integridade física da RAM." Style="{StaticResource Note}" Margin="0"/></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="Testar leitura…" Command="{Binding DiskReadCommand}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="Disco · leitura de até 64 MiB" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha um arquivo existente. O resultado pode refletir cache do Windows." Style="{StaticResource Note}" Margin="0"/></StackPanel></DockPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Resultados">
                    <TabControl x:Name="ResultPages" SelectedIndex="{Binding ResultTab}" BorderThickness="0">
                        <TabItem Header="Observações">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <TextBlock Text="Selecione uma observação para consultar sua explicação e as leituras que a sustentam." Style="{StaticResource Note}"/>
                                <ListBox ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" MaxHeight="210"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Component}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                                <Border Style="{StaticResource Card}" Margin="0,16,0,16"><StackPanel>
                                    <TextBlock Text="{Binding SelectedFinding.Title, TargetNullValue=Aguardando dados para a análise, FallbackValue=Aguardando dados para a análise}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedFindingCategory}" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding SelectedFinding.Explanation}" Style="{StaticResource Note}"/>
                                    <TextBlock Text="Próximo passo" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="{Binding SelectedFinding.Recommendation}" Style="{StaticResource Note}"/>
                                    <TextBlock Text="{Binding SelectedFinding.Verification}" Style="{StaticResource Note}"/>
                                    <Expander Header="Evidências, confiança e limitações"><StackPanel Margin="6,10,6,0">
                                        <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,12"><Run Text="Confiança: "/><Run Text="{Binding SelectedFindingConfidence, Mode=OneWay}"/></TextBlock>
                                        <ItemsControl ItemsSource="{Binding SelectedFinding.Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="{Binding Value, Mode=OneWay, StringFormat={}{0:0.###}}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/></TextBlock></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <TextBlock Text="{Binding SelectedFinding.Context}" Style="{StaticResource Note}"/><TextBlock Text="{Binding SelectedFinding.Requirements}" Style="{StaticResource Note}"/><TextBlock Text="{Binding SelectedFinding.ExpectedImpact}" Style="{StaticResource Note}"/><TextBlock Text="{Binding SelectedFinding.Reversal}" Style="{StaticResource Note}"/>
                                    </StackPanel></Expander>
                                </StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Último teste">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <TextBlock Text="{Binding OperationTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="O resultado de um teste aparece aqui automaticamente quando ele termina." Style="{StaticResource Note}"/>
                                <Border Style="{StaticResource Card}" Visibility="{Binding HasRelativeSeries, Converter={StaticResource BooleanVisibility}}"><StackPanel>
                                    <TextBlock Text="Série de frames" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding ResultSeries}" SelectedItem="{Binding SelectedRelativeSeries}" DisplayMemberPath="Name"/>
                                    <controls:RelativeTimeSeriesChart Series="{Binding SelectedRelativeSeries}" Height="210"/>
                                    <Expander Header="Base de tempo e origem"><StackPanel Margin="6,10,6,0"><TextBlock Text="{Binding SelectedRelativeSeries.TimeBasis}" Style="{StaticResource Note}"/><TextBlock Text="{Binding SelectedRelativeSeries.Source}" Style="{StaticResource Note}"/><TextBlock Text="O gráfico mostra os últimos 10.000 frames retidos. As estatísticas usam os dados da captura; não há correlação UTC automática." Style="{StaticResource Note}"/></StackPanel></Expander>
                                </StackPanel></Border>
                                <TextBox Text="{Binding OperationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="260" MaxHeight="520" FontFamily="Consolas" FontSize="12" Padding="16" AutomationProperties.Name="Resultado técnico do último teste"/>
                                <Button Content="Escolher outro teste" Command="{Binding NavigateCommand}" CommandParameter="investigar" HorizontalAlignment="Left"/>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Fontes disponíveis">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <TextBlock Text="Uma leitura ausente pode indicar falta de provedor, ferramenta ou permissão. Isso não confirma um defeito no componente." Style="{StaticResource Note}"/>
                                <ItemsControl ItemsSource="{Binding Capabilities}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status, Converter={StaticResource AvailabilityLabel}}" Foreground="{StaticResource Muted}" FontSize="11" Margin="16,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Histórico">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,12">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsLiveView}"><StackPanel>
                            <TextBlock Text="Guardar a coleta ao vivo" Style="{StaticResource SectionTitle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Nome da sessão" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding SessionLabel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="O que estava fazendo?" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding Workload, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exemplo: repouso, jogo e cena específica, renderização."/></StackPanel>
                            </Grid>
                            <Expander Header="Adicionar contexto e notas"><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="6,10,6,0"/></Expander>
                            <WrapPanel><Button Content="Salvar sessão" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Salvar e iniciar outra" Command="{Binding NewSessionCommand}"/></WrapPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Atualizar lista" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/><TextBlock Text="Sessões salvas" Style="{StaticResource SectionTitle}"/></DockPanel>
                            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Sessão" Binding="{Binding Label}" Width="1.5*"/><DataGridTextColumn Header="Data" Binding="{Binding StartedAt, StringFormat={}{0:g}}" Width="*"/><DataGridTextColumn Header="Condição" Binding="{Binding Workload}" Width="1.5*"/><DataGridTextColumn Header="Amostras" Binding="{Binding SampleCount}" Width="90"/></DataGrid.Columns></DataGrid>
                            <Button Content="Abrir sessão selecionada" Command="{Binding LoadSessionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comparar antes e depois" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha duas sessões com a mesma carga e contexto. Diferenças não comprovam que um ajuste causou a mudança." Style="{StaticResource Note}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Antes" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding BeforeSession}" DisplayMemberPath="Label"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Depois" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding AfterSession}" DisplayMemberPath="Label"/></StackPanel></Grid>
                            <Button Content="Comparar sessões" Command="{Binding CompareCommand}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Exportar a sessão visualizada" Style="{StaticResource SectionTitle}"/><CheckBox Content="Ocultar identificadores e caminhos pessoais" IsChecked="{Binding Anonymize}"/><WrapPanel><Button Content="Relatório HTML…" Command="{Binding ExportHtmlCommand}"/><Button Content="CSV…" Command="{Binding ExportCsvCommand}"/><Button Content="JSON…" Command="{Binding ExportJsonCommand}"/></WrapPanel></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Ajustes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,12">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comece lendo a configuração atual" Style="{StaticResource SectionTitle}"/><TextBlock Text="O programa mostra os planos e as propriedades disponíveis no seu computador. Cada alteração exige revisão e confirmação." Style="{StaticResource Note}"/><Button Content="Ler configurações disponíveis" Command="{Binding RefreshOptimizationCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Plano de energia" Style="{StaticResource SectionTitle}"/><TextBlock Text="Um plano diferente pode aumentar consumo, temperatura ou ruído. Meça novamente para verificar o efeito." Style="{StaticResource Note}"/><ComboBox ItemsSource="{Binding PowerPlans}" SelectedItem="{Binding SelectedPowerPlan}" DisplayMemberPath="Name"/><Button Content="Revisar alteração de energia…" Command="{Binding PowerPreviewCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Propriedades do adaptador de rede" Style="{StaticResource SectionTitle}"/><ComboBox ItemsSource="{Binding NetworkSettings}" SelectedItem="{Binding SelectedNetworkSetting}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding AdapterName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"><Run Text="Valor atual: "/><Run Text="{Binding SelectedNetworkSetting.CurrentValue, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="Novo valor suportado pelo driver" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding NetworkValues}" SelectedItem="{Binding SelectedNetworkValue}" DisplayMemberPath="Name"/>
                            <Expander Header="Efeitos e limitações da propriedade"><StackPanel Margin="6,10,6,0"><TextBlock Text="{Binding SelectedNetworkSetting.Keyword}" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding SelectedNetworkSetting.Explanation}" Style="{StaticResource Note}" Margin="0,8,0,0"/></StackPanel></Expander>
                            <Button Content="Revisar alteração de rede…" Command="{Binding NetworkPreviewCommand}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Restaurar uma alteração" Style="{StaticResource SectionTitle}"/><TextBlock Text="O valor original é registrado antes da mudança. Selecione uma alteração para revisar sua restauração." Style="{StaticResource Note}"/>
                            <DataGrid ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" Height="200"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="*"/><DataGridTextColumn Header="Operação" Binding="{Binding Kind, Converter={StaticResource ChangeLabel}}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State, Converter={StaticResource ChangeLabel}}" Width="*"/><DataGridTextColumn Header="Valor anterior" Binding="{Binding Before}" Width="*"/></DataGrid.Columns></DataGrid>
                            <TextBlock Text="{Binding SelectedChange.Error}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedChange.RecoveryInstructions}" Style="{StaticResource Note}" Margin="0,6,0,12"/>
                            <Button Content="Restaurar valor anterior…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Configurações">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,12">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Frequência da coleta" Style="{StaticResource SectionTitle}"/><TextBlock Text="Leve usa 5 segundos por padrão. Avançado usa 1 segundo. Ao minimizar, o intervalo passa para pelo menos 15 segundos." Style="{StaticResource Note}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Perfil" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding CollectionModes}" SelectedItem="{Binding Mode}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Intervalo (segundos)" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding IntervalSeconds}"/></StackPanel></Grid>
                            <Button Content="Salvar preferências" Command="{Binding SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados e registros locais" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Sessões e registros ficam nessa pasta. O aplicativo inicia somente a descoberta e a coleta passiva." Style="{StaticResource Note}"/><TextBlock Text="{Binding BufferInfo}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Disponibilidade e permissões" Style="{StaticResource SectionTitle}"/><TextBlock Text="Algumas leituras dependem de provedores do Windows, do driver NVIDIA ou de ferramentas opcionais. Leituras ausentes ficam explícitas." Style="{StaticResource Note}"/><Button Content="Ver fontes disponíveis" Command="{Binding NavigateCommand}" CommandParameter="fontes" HorizontalAlignment="Left"/><Expander Header="Limites da coleta e operações administrativas"><StackPanel Margin="6,10,6,0"><TextBlock Text="Atualização visual de aproximadamente 1 segundo. Cada leitura preserva sua origem e intervalo real. O buffer retém até 30.000 amostras e os gráficos mostram as últimas 600 de uma métrica." Style="{StaticResource Note}"/><TextBlock Text="O aplicativo não instala drivers de sensores. Temperatura de CPU, timings, canais e SMART indisponíveis não são estimados a partir da utilização." Style="{StaticResource Note}"/><TextBlock Text="Capturas profundas e alterações protegidas solicitam autorização pelo UAC depois de uma ação manual. Alterar uma propriedade de rede pode exigir um reinício posterior autorizado separadamente." Style="{StaticResource Note}"/></StackPanel></Expander></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="24,8,24,0" Padding="0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Width="110" Height="5" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceHigh}" BorderThickness="0" Margin="0,0,12,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="0"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Margin="0" MinHeight="30" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
