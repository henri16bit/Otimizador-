                                    <TextBlock Text="{Binding SelectedNetworkSetting.Explanation}" Style="{StaticResource Note}"/>
                                    <Button Content="Ver recomendações" Command="{Binding ReviewNetworkSettingCommand}" HorizontalAlignment="Left"/>
                                </StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Jogos">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Analise quedas de FPS e irregularidade de frames" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Se você já tem um CSV do PresentMon, importe-o para ver FPS, frametimes e percentis." Style="{StaticResource Note}"/>
                                    <Expander Header="CSV com QPC ou data/hora: informar relógio"><StackPanel Margin="8">
