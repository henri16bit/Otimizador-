                                    <Expander Header="Ferramenta e permissões"><TextBlock Text="O PresentMon é uma ferramenta externa opcional. A captura não injeta código nem cria overlay. A compatibilidade com o jogo e com anticheat depende do ambiente; não há garantia de compatibilidade com Vanguard. A importação CSV funciona sem executar o PresentMon." Style="{StaticResource Note}" Margin="6,10,6,0"/></Expander>
                                </StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Travadas e drivers">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,20,16,16">
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="Investigue atividade de drivers durante uma travada" Style="{StaticResource SectionTitle}"/>
