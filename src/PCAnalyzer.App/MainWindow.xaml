                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="{StaticResource Accent}"/></Grid>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" Margin="0,4,0,4"/>
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11"><Run Text="Última atualização: "/><Run Text="{Binding LastUpdated, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Frequência da coleta" Style="{StaticResource SectionTitle}"/><TextBlock Text="Leve usa 5 segundos por padrão. Avançado usa 1 segundo. Ao minimizar, o intervalo passa para pelo menos 15 segundos." Style="{StaticResource Note}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Perfil" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding CollectionModes}" SelectedItem="{Binding Mode}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Intervalo (segundos)" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding IntervalSeconds}"/></StackPanel></Grid>
                            <Button Content="Salvar preferências" Command="{Binding SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados e registros locais" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/><Button Content="Abrir pasta de dados e logs" Command="{Binding OpenDataDirectoryCommand}" HorizontalAlignment="Left"/><TextBlock Text="Sessões e registros ficam nessa pasta. O aplicativo inicia somente a descoberta e a coleta passiva." Style="{StaticResource Note}"/><TextBlock Text="{Binding BufferInfo}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding CollectorCost}" Style="{StaticResource Note}" Margin="0,10,0,0"/><TextBlock Text="Custo medido no processo do analisador. GPU da interface e impacto em partidas exigem medição externa." Style="{StaticResource Note}" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Disponibilidade e permissões" Style="{StaticResource SectionTitle}"/><TextBlock Text="Algumas leituras dependem de provedores do Windows, do driver NVIDIA ou de ferramentas opcionais. Leituras ausentes ficam explícitas." Style="{StaticResource Note}"/><Button Content="Ver fontes disponíveis" Command="{Binding NavigateCommand}" CommandParameter="fontes" HorizontalAlignment="Left"/><Expander Header="Limites da coleta e operações administrativas"><StackPanel Margin="6,10,6,0"><TextBlock Text="Atualização visual de aproximadamente 1 segundo. Cada leitura preserva sua origem e intervalo real. O buffer retém até 30.000 amostras e os gráficos mostram as últimas 600 de uma métrica." Style="{StaticResource Note}"/><TextBlock Text="O aplicativo não instala drivers de sensores. Temperatura de CPU, timings, canais e SMART indisponíveis não são estimados a partir da utilização." Style="{StaticResource Note}"/><TextBlock Text="Capturas profundas e alterações protegidas solicitam autorização pelo UAC depois de uma ação manual. Alterar uma propriedade de rede pode exigir um reinício posterior autorizado separadamente." Style="{StaticResource Note}"/></StackPanel></Expander></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Analisar">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,12">
                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Padding="16" Visibility="{Binding TestIsActive, Converter={StaticResource BooleanVisibility}}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ExecutionPanel}"/>
                        </Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Análise do computador" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Reúna CPU, memória, discos e rede em um resultado explicado. Use o PC como no momento do problema." Style="{StaticResource Note}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Observar por" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding ObservationDurations}" SelectedItem="{Binding ObservationSeconds}" AutomationProperties.Name="Duração da análise"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} segundos}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="O que você está fazendo?" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox Text="{Binding Workload, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Condição da análise" ToolTip="Exemplo: repouso, jogo aberto, copiando arquivos."/></StackPanel>
                            </Grid>
                            <TextBlock Text="Incluir nesta análise" FontWeight="SemiBold" Margin="0,4,0,10"/>
                            <CheckBox IsChecked="{Binding IncludePing}"><TextBlock Text="Resposta da rede · envia 20 pings ICMP" TextWrapping="Wrap"/></CheckBox>
                            <StackPanel Visibility="{Binding IncludePing, Converter={StaticResource BooleanVisibility}}" Margin="22,0,0,8">
                                <TextBlock Text="Destino: gateway, IP ou nome DNS" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destino da análise de rede"/>
                                <TextBlock Text="Gateway testa sua rede local. A resposta ICMP não mede a latência dentro do jogo." Style="{StaticResource Note}" Margin="0"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IncludeLatency}"><TextBlock Text="Travadas e drivers · captura DPC/ISR por 30 segundos" TextWrapping="Wrap"/></CheckBox>
                            <TextBlock Text="O Windows pedirá permissão de administrador. A captura acrescenta trabalho ao sistema e pode prolongar a análise." Style="{StaticResource Note}" Margin="22,0,0,12" Visibility="{Binding IncludeLatency, Converter={StaticResource BooleanVisibility}}"/>
                            <Button Content="ANALISAR MEU PC" Command="{Binding AnalyzePcCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="22,12"/>
                            <TextBlock Text="Você pode cancelar ou mudar de tela. O resultado será salvo aqui e no histórico." Style="{StaticResource Note}" Margin="0,4,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Análise durante um jogo" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Capture 30 segundos de frames para investigar fluidez, quedas de FPS e variação entre quadros." Style="{StaticResource Note}"/>
                            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="7" Padding="12" Margin="0,0,0,14">
                                <StackPanel><TextBlock Text="PresentMon" FontWeight="SemiBold"/><TextBlock Text="{Binding PresentMonStatus}" TextWrapping="Wrap" Margin="0,5,0,8"/><Button Content="Configurar PresentMon…" Command="{Binding ConfigurePresentMonCommand}" HorizontalAlignment="Left" Margin="0"/><TextBlock Text="{Binding PresentMonPath}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Text="Escolha o jogo ou aplicativo aberto" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding VisibleProcesses}" SelectedItem="{Binding SelectedProcess}" AutomationProperties.Name="Processo da análise de jogo"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · PID "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBlock Text="{Binding ProcessEmptyMessage}" TextWrapping="Wrap" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VisibleProcesses.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <Expander Header="Jogo ainda fechado ou processo fora da lista"><StackPanel Margin="8,8,0,4">
                                <TextBlock Text="Para aguardar o jogo, informe o nome do processo sem .exe. Deixe vazio para usar a seleção acima." Style="{StaticResource Note}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Nome do processo" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox Text="{Binding GameWaitProcessName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do processo a aguardar"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Esperar até (segundos)" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox Text="{Binding GameWaitSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Limite de espera pelo jogo"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Ou informe o PID de um processo já aberto" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding ProcessIdText, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="PID da análise de jogo"/>
                            </StackPanel></Expander>
                            <Button Content="Analisar jogo por 30 segundos" Command="{Binding AnalyzeGamesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            <TextBlock Text="A captura usa uma ferramenta externa. Compatibilidade e dados disponíveis dependem do jogo e das permissões." Style="{StaticResource Note}" Margin="0,4,0,0"/>
                            <Button Content="Já tenho uma captura CSV" Command="{Binding OpenInvestigationCommand}" CommandParameter="jogos" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Avançado">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,12">
                        <TextBlock Text="Abra uma ferramenta quando precisar investigar um resultado. As análises guiadas continuam disponíveis em Analisar." Style="{StaticResource Note}"/>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Acompanhar o computador" Style="{StaticResource SectionTitle}"/><TextBlock Text="Veja medições, gráficos e os aplicativos em execução." Style="{StaticResource Note}"/><WrapPanel><Button Content="Componentes e gráficos" Command="{Binding NavigateCommand}" CommandParameter="componentes"/><Button Content="Processos" Command="{Binding NavigateCommand}" CommandParameter="processos"/><Button Content="Fontes de dados" Command="{Binding NavigateCommand}" CommandParameter="fontes"/></WrapPanel></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Investigar um sintoma" Style="{StaticResource SectionTitle}"/><TextBlock Text="Escolha uma medição específica. Capturas e testes começam somente após sua ação." Style="{StaticResource Note}"/><WrapPanel><Button Content="Rede e conexão" Command="{Binding OpenInvestigationCommand}" CommandParameter="rede"/><Button Content="Travadas e drivers" Command="{Binding OpenInvestigationCommand}" CommandParameter="drivers"/><Button Content="Jogos e frames" Command="{Binding OpenInvestigationCommand}" CommandParameter="jogos"/><Button Content="Testes de CPU, RAM e disco" Command="{Binding OpenInvestigationCommand}" CommandParameter="testes"/></WrapPanel></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Reabrir e comparar" Style="{StaticResource SectionTitle}"/><TextBlock Text="Consulte análises e sessões salvas. Compare medições feitas sob as mesmas condições." Style="{StaticResource Note}"/><Button Content="Histórico e exportação" Command="{Binding NavigateCommand}" CommandParameter="historico" HorizontalAlignment="Left"/></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="24,8,24,0" Padding="0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Notification}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding Notification}"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Width="110" Height="5" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceHigh}" BorderThickness="0" Margin="0,0,12,0"><ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="0"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Margin="0" MinHeight="30" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
