                        <Expander Header="Auditoria completa · evidências e limitações" IsExpanded="False" Margin="0,20,0,8"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource TechnicalConsultationReportTemplate}" Margin="0,12,0,0"/></Expander>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Categoria">
