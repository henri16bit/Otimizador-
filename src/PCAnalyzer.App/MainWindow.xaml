                                <WrapPanel>
                                    <Button Content="Atualizar auditoria" Command="{Binding AuditConfigurationCommand}"/>
                                    <Button Content="Exportar relatório…" Command="{Binding ExportAuditCommand}" Style="{StaticResource QuietButton}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding AuditSettingsSummary}" Style="{StaticResource Note}" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsNetworkCategory, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,16">
                                <TextBlock Text="Estado da conexão" Style="{StaticResource SectionTitle}"/>
                                <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="Recarregar" Command="{Binding DiscoverNetworkCommand}" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding VisibleNetworkAdapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" Margin="0" AutomationProperties.Name="Adaptador da categoria Rede"/></DockPanel>
